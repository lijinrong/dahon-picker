---
import { parseFoldedSize } from '../lib/foldedSize'

interface Props { size: string }
const { size } = Astro.props
const dim = parseFoldedSize(size)
const parsed = dim.parsed

const A4_W = 29.7
const A4_H = 21
const MAX_PX = 180
const maxCm = parsed ? Math.max(dim.length, dim.width) : 0
const scale = maxCm > 0 ? MAX_PX / maxCm : 1
const bikeW = parsed ? Math.round(dim.length * scale) : 0
const bikeH = parsed ? Math.round(dim.width * scale) : 0
const a4W = parsed ? Math.round(A4_W * scale) : 0
const a4H = parsed ? Math.round(A4_H * scale) : 0
---

{parsed ? (
  <div class="folded-size-viz" style={`--bw:${bikeW}px;--bh:${bikeH}px;--aw:${a4W}px;--ah:${a4H}px`}>
    <div class="folded-pair">
      <div class="folded-bike">
        <span class="folded-dim-label">{dim.length}cm</span>
        <span class="folded-dim-label folded-dim-side">{dim.width}cm</span>
      </div>
      <div class="folded-ref">
        <span class="folded-ref-label">A4</span>
      </div>
    </div>
    <p class="folded-note">高 {dim.height}cm · 虚线框为 A4 纸参考</p>
  </div>
) : (
  <span>{size}</span>
)}

<style>
  .folded-size-viz { margin: 0.5rem 0; }
  .folded-pair {
    display: flex;
    align-items: flex-end;
    gap: 0.75rem;
    margin: 0.5rem 0 0.25rem;
  }
  .folded-bike {
    width: var(--bw);
    height: var(--bh);
    position: relative;
    background: var(--color-primary);
    opacity: 0.12;
    border: 2px solid var(--color-primary);
    border-radius: 4px;
    flex-shrink: 0;
  }
  .folded-ref {
    width: var(--aw);
    height: var(--ah);
    position: relative;
    border: 2px dashed var(--color-line);
    border-radius: 2px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .folded-ref-label {
    font-size: var(--text-small);
    color: var(--color-ink-soft);
    background: var(--color-bg);
    padding: 0 0.2em;
    border-radius: 2px;
  }
  .folded-dim-label {
    position: absolute;
    bottom: -1.25em;
    left: 50%;
    transform: translateX(-50%);
    font-size: var(--text-small);
    color: var(--color-ink-soft);
    white-space: nowrap;
  }
  .folded-dim-side {
    bottom: auto;
    left: -0.25em;
    top: 50%;
    transform: translateY(-50%) rotate(-90deg);
    transform-origin: center;
  }
  .folded-note {
    font-size: var(--text-small);
    color: var(--color-ink-soft);
    margin: 0.25em 0 0;
  }
</style>
